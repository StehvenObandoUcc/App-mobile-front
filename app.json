{
  "expo": {
    "name": "Food AI",
    "slug": "mobile",
    "scheme": "foodai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF9F2"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.foodai.app",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#1B4332",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Food AI necesita acceso a la cámara para escanear y reconocer los alimentos de tu despensa."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Food AI necesita acceso a tus fotos para personalizar tu foto de perfil."
        }
      ],
      "expo-secure-store"
    ]
  }
}
