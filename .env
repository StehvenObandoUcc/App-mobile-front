# URL base de la API del backend
# Para probar la APK en tu celular conectado a la misma red WiFi, puedes cambiar localhost por la IP de tu PC (ej. http://192.168.1.15:8000)
# Para producción en la nube, asigna la URL pública HTTPS de tu servicio desplegado (ej. https://tu-api.onrender.com)
EXPO_PUBLIC_API_URL=http://localhost:8000
